#!/bin/sh
set -eu
: "${HORIZON_STUB_STATE:?HORIZON_STUB_STATE is required}"
[ -z "${HORIZON_STUB_LOG:-}" ] || printf '%s\n' "$*" >> "$HORIZON_STUB_LOG"

python3 - "$HORIZON_STUB_STATE" "$@" <<'PY'
import json, os, pathlib, re, sys
state = json.loads(pathlib.Path(sys.argv[1]).read_text())
args = sys.argv[2:]
if args == ["version"]:
    print("horizon version " + state.get("version", "1.0.0"))
elif args == ["version", "--check", "--json"]:
    if state.get("versionCheckUnsupported"):
        print("unknown flag: --check", file=sys.stderr)
        raise SystemExit(2)
    current = state.get("version", "1.0.0")
    latest = state.get("latestVersion", current)
    print(json.dumps({"current": current, "latest": latest, "available": True, "updateAvailable": state.get("updateAvailable", current != latest)}, separators=(",", ":")))
elif args == ["connection", "list", "--check", "--json"]:
    lists = state.get("profileLists")
    if lists:
        profiles = lists.pop(0) if len(lists) > 1 else lists[0]
        pathlib.Path(sys.argv[1]).write_text(json.dumps(state))
    else:
        profiles = state.get("profiles", [])
    print(json.dumps(profiles, separators=(",", ":")))
elif args and args[0] == "request":
    try:
        label = args[args.index("--connection") + 1]
    except (ValueError, IndexError):
        print("missing explicit --connection", file=sys.stderr)
        raise SystemExit(2)
    expected = state.get("selected")
    if expected and label != expected:
        print("wrong connection", file=sys.stderr)
        raise SystemExit(2)
    contract_file = os.environ.get("HORIZON_STUB_CONTRACT")
    if contract_file:
        contracts = json.loads(pathlib.Path(contract_file).read_text())
        positional = []
        i = 1
        while i < len(args):
            if args[i].startswith("--"):
                i += 2
            else:
                positional.append(args[i])
                i += 1
        if len(positional) != 2:
            print("invalid request arguments", file=sys.stderr)
            raise SystemExit(2)
        key = " ".join(positional)
        if key not in contracts:
            print("request absent from externally supplied Installation contract", file=sys.stderr)
            raise SystemExit(2)
        discovered = state.get("discovered", ["/discovery"])
        if not any(re.fullmatch(re.sub(r"\\\{[^}]+\\\}", "[^/]+", re.escape(link)), positional[1]) for link in discovered):
            print("request did not follow a previously returned link", file=sys.stderr)
            raise SystemExit(2)
        response = contracts[key]
        def collect(value):
            if isinstance(value, str) and value.startswith("/"):
                path = value.split("#", 1)[0]
                if path not in discovered:
                    discovered.append(path)
            elif isinstance(value, dict):
                for name, child in value.items():
                    if name != "examples":
                        collect(child)
            elif isinstance(value, list):
                for child in value:
                    collect(child)
        collect(response["body"])
        state["discovered"] = discovered
        pathlib.Path(sys.argv[1]).write_text(json.dumps(state))
        print(json.dumps(response["body"], separators=(",", ":")))
        if response["status"] >= 400:
            raise SystemExit(1)
    else:
        print(json.dumps(state.get("response", {"ok": True}), separators=(",", ":")))
else:
    print("unexpected command", file=sys.stderr)
    raise SystemExit(2)
PY
